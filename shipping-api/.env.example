# PostgreSQL — stesso DB dell'Order Portal, schema viscotta
DATABASE_URL=postgresql://user:password@localhost:5432/viscotta

# MyDHL API — Basic Auth, stesso account number per nazionale e internazionale.
# DHL_API_BASE_URL: produzione di default, va puntato a .../mydhlapi/test
# finché l'account non è abilitato in produzione (vedi piano-sprint.md)
DHL_ACCOUNT_NUMBER=
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi

# Indirizzo di origine (magazzino VISCOTTA) — richiesto da /rates, /shipments, /pickups
DHL_ORIGIN_COUNTRY_CODE=IT
DHL_ORIGIN_POSTAL_CODE=
DHL_ORIGIN_CITY=
DHL_ORIGIN_ADDRESS_LINE=

# Dati di contatto mittente — richiesti solo da /shipments e /pickups (non da /rates)
DHL_ORIGIN_COMPANY_NAME=
DHL_ORIGIN_CONTACT_NAME=
DHL_ORIGIN_EMAIL=
DHL_ORIGIN_PHONE=

# Dimensioni scatolone in cm — opzionali: senza, la quotazione DHL usa solo il peso
DHL_SCATOLONE_LUNGHEZZA_CM=
DHL_SCATOLONE_LARGHEZZA_CM=
DHL_SCATOLONE_ALTEZZA_CM=
