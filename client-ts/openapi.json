    "/spedizioni/{spedizione_id}/conferma": {
      "post": {
        "summary": "Conferma Spedizione",
        "description": "bozza -> confermata. QUESTA CHIAMATA HA EFFETTO REALE: crea la\nspedizione DHL vera con relativo costo (dhl.crea_spedizione). Va\ninvocata solo dopo controllo umano della bozza (GET /spedizioni/{id}).\n\nGate: rifiuta (409) se il reparto non ha ancora scansionato tutti i\ncolli dell'ordine (vedi POST /cartonizzazioni/colli/conferma) — senza\nquesto controllo si potrebbe confermare (costo reale, ritiro reale)\nuna spedizione con uno scatolone ancora aperto sul tavolo.",
        "operationId": "conferma_spedizione_spedizioni__spedizione_id__conferma_post",
        "parameters": [
          {
            "name": "spedizione_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Spedizione Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpedizioneResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
