    "/cartonizzazioni/piano-giorno/{data_consegna}": {
      "get": {
        "summary": "Piano Giorno",
        "description": "Piano di cartonizzazione del giorno: un PDF A4, 4 ordini per pagina\n(2×2, linee di taglio), da stampare e allegare fisicamente a ogni ordine\nin laboratorio — documento ufficiale pre-produzione. Un ordine per\nritaglio: le etichette collo WP50/WP40 (lotto/scadenza reali) arrivano\ndopo, a produzione fatta.",
        "operationId": "piano_giorno_cartonizzazioni_piano_giorno__data_consegna__get",
        "parameters": [
          {
            "name": "data_consegna",
            "in": "path",
