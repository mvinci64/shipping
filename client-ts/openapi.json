    "/cartonizzazioni/{order_number}/etichette-colli": {
      "get": {
        "summary": "Etichette Colli Ordine Reale",
        "description": "Etichette collo (WP50/WP40) per un ordine reale, letto dal DB.\nLotto/scadenza reali da easyfatt.tmovmagazz (ultimo carico per SKU);\nse uno SKU non ha mai avuto un carico in EasyFatt resta il placeholder.\n\ncon_lotto=false: stampa in anticipo, quando solo alcuni SKU dell'ordine\nsono già stati prodotti (es. un ordine con più prodotti, di cui oggi è\nuscito dal laboratorio solo il primo) — lotto/scadenza verrebbero\ndisallineati per il resto dell'ordine, quindi vengono omessi per tutta\nl'etichetta. Il barcode resta comunque (GTIN da solo, senza lotto):\nidentifica il prodotto anche quando lotto/scadenza non sono ancora\naffidabili.",
        "operationId": "etichette_colli_ordine_reale_cartonizzazioni__order_number__etichette_colli_get",
        "parameters": [
          {
            "name": "order_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Number"
            }
          },
          {
            "name": "con_lotto",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Con Lotto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cartonizzazioni/{order_number}/etichette-scatolone": {
      "get": {
        "summary": "Etichette Scatolone Ordine Reale",
        "description": "Etichetta scatolone (una per collo di spedizione): riepilogo interno\ndi cosa contiene, con dati reali dell'ordine (cliente, data consegna).\nDistinta dalle etichette collo WP50/WP40 e dall'etichetta ufficiale del\ncorriere (DHL/BRT), che resta da applicare a parte alla conferma\nspedizione.",
        "operationId": "etichette_scatolone_ordine_reale_cartonizzazioni__order_number__etichette_scatolone_get",
        "parameters": [
          {
            "name": "order_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cartonizzazioni/colli/conferma": {
      "post": {
        "summary": "Conferma Collo Scansionato",
        "description": "Conferma di fine linea: il reparto scansiona il barcode già stampato\nsull'etichetta scatolone (Code128 \"<ordine>-NN\") — nessuna digitazione\nmanuale, nessun nuovo strumento in laboratorio. Idempotente: scansionare\ndue volte lo stesso collo per errore non è un errore. 422 se l'indice\nnon esiste nella cartonizzazione attuale dell'ordine (es. barcode di un\nordine sbagliato, o cartonizzazione cambiata dopo la stampa).",
        "operationId": "conferma_collo_scansionato_cartonizzazioni_colli_conferma_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScansioneCollo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatoColli"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cartonizzazioni/{order_number}/colli": {
      "get": {
        "summary": "Stato Colli Ordine",
        "description": "Stato delle conferme di fine linea per un ordine: quanti colli sono\nstati scansionati, quali mancano. Usare prima di confermare la\nspedizione (POST /spedizioni/{id}/conferma ha effetto reale).",
        "operationId": "stato_colli_ordine_cartonizzazioni__order_number__colli_get",
        "parameters": [
          {
            "name": "order_number",
            "in": "path",
            "required": true,
