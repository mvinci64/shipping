    "/spedizioni/valida/{order_number}": {
      "post": {
        "summary": "Valida Spedizione",
        "description": "Quota la spedizione di un ordine reale via MyDHL API (POST /rates) —\nnessuna spedizione viene creata, nessuna etichetta emessa: è la\n\"bozza\" emulata. Combina cartonizzazione (pesi scatoloni) e indirizzo\ncliente da DB.",
        "operationId": "valida_spedizione_spedizioni_valida__order_number__post",
        "parameters": [
          {
            "name": "order_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Valida Spedizione Spedizioni Valida  Order Number  Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/spedizioni": {
      "post": {
        "summary": "Crea Bozza Spedizione",
        "description": "Crea la bozza (stato 'bozza'): quota via /rates e salva su DB.\nNessuna chiamata DHL con effetto reale — solo /rates, come /valida.",
        "operationId": "crea_bozza_spedizione_spedizioni_post",
        "parameters": [
          {
            "name": "order_number",
